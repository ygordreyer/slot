shaders = 3

shader0 = ../motionblur/shaders/response-time.glsl
filter_linear0 = false
scale_type0 = source
scale0 = 1.0

shader1 = shaders/mgba/agb001.glsl
filter_linear1 = false
scale_type1 = source
scale1 = 3.0

shader2 = shaders/color/gba-color.glsl
filter_linear2 = false
scale_type2 = viewport

# Match the panel grid and avoid stacking a second darkening curve.
parameters = LCD_SCALE;MASK_STRENGTH;darken_screen
LCD_SCALE = 3.0
MASK_STRENGTH = 0.35
darken_screen = 0.0
