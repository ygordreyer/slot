CARD = '/mnt/sdcard'
HOLD = '/run/slop-hold'
AWAKE = '/run/slop-awake'
CABLE_HINT = ('Connect a data USB-A to USB-C cable BEFORE powering on. BaseOS binds adb at boot; '
              'a cable-only start may enter charger mode, so press POWER.')
PROTECTED = {'games', 'saves', 'states', 'bios'}
PAYLOAD = {'System', 'Shaders', 'Config', 'Cheats', 'Labels', 'Wallpapers'}
# crates/slot/src/input/evdev.rs:12-14,85-104.
BUTTONS = {
    'A': (1, 0x130, 1), 'B': (1, 0x131, 1), 'Y': (1, 0x132, 1),
    'X': (1, 0x133, 1), 'L1': (1, 0x134, 1), 'R1': (1, 0x135, 1),
    'SELECT': (1, 0x136, 1), 'START': (1, 0x137, 1), 'MENU': (1, 0x138, 1),
    'L2': (1, 0x13a, 1), 'R2': (1, 0x13b, 1),
    'VOLUP': (1, 115, 1), 'VOLDOWN': (1, 114, 1), 'POWER': (1, 116, 1),
    'LEFT': (3, 0x10, -1), 'RIGHT': (3, 0x10, 1),
    'UP': (3, 0x11, -1), 'DOWN': (3, 0x11, 1),
}


class Error(Exception):
    pass


def q(value):
    """The single device-side argument quoting boundary."""
    return shlex.quote(str(value))


def parse_shell(text):
    text = text.replace('\r', '')
    match = re.search(r'\n__slopctl_rc=(\d+)\n?\Z', text)
    if not match:
        raise Error('adb shell returned no exit-status sentinel')
    output = text[:match.start()]
    rc = int(match.group(1))
    if rc:
        raise Error(f'device command exited {rc}' + (f': {output.strip()}' if output.strip() else ''))
    return output


class Adb:
    name = 'adb'

    def __init__(self):
        self.binary = shutil.which('adb') or '/opt/homebrew/bin/adb'
        self.serial = None

    def run(self, args, timeout=30, interactive=False):
        argv = [self.binary] + (['-s', self.serial] if self.serial else []) + list(args)
        try:
            result = subprocess.run(argv, timeout=min(timeout, 30),
                                    capture_output=not interactive, text=not interactive)
        except FileNotFoundError:
            raise Error('adb is missing. Install Android platform-tools and put adb on PATH.') from None
        except subprocess.TimeoutExpired:
            raise Error(f'adb command timed out after {min(timeout, 30):g} s') from None
        if result.returncode:
            detail = '' if interactive else (result.stderr or result.stdout).strip().replace('\r', '')
            raise Error(f'adb exited {result.returncode}: {detail}')
        return '' if interactive else result.stdout.replace('\r', '')

    def connect(self, timeout=5):
        try:
            listing = self.run(['devices', '-l'], timeout=timeout)
        except Error as exc:
            detail = str(exc)
            if 'Operation not permitted' in detail:
                detail = 'adb server access denied by this environment'
            else:
                detail = ' '.join(detail.splitlines())
            raise Error('Cannot query USB adb: ' + detail + '. ' + CABLE_HINT) from None
        rows = [line.split() for line in listing.splitlines() if line and not line.startswith('List ')]
        # Never select a TCP transport. BaseOS only exposes USB.
        ready = [r for r in rows if len(r) >= 2 and r[1] == 'device' and ':' not in r[0]]
        if not ready:
            raise Error('No USB adb device ready. ' + CABLE_HINT)
        if len(ready) != 1:
            raise Error('Multiple USB adb devices ready. Disconnect the other devices.')
        self.serial = ready[0][0]
        return self.serial

    def shell(self, command, timeout=30):
        wrapper = f"sh -c {q(command)}; printf '\\n__slopctl_rc=%s\\n' \"$?\""
        # Old adbd has small service-name packets. Transfer long scripts as files.
        if len(wrapper.encode()) > 2000:
            remote = '/tmp/slopctl-script-' + uuid.uuid4().hex
            try:
                with tempfile.TemporaryDirectory(prefix='slopctl-script-') as td:
                    local = Path(td) / 'command.sh'
                    local.write_text(command + '\n')
                    self.push(local, remote)
                    return self.shell('sh ' + q(remote), timeout=timeout)
            finally:
                self.shell('rm -f ' + q(remote), timeout=5)
        return parse_shell(self.run(['shell', wrapper], timeout=timeout))

    def push(self, src, dst):
        return self.run(['push', str(src), str(dst)])

    def pull(self, src, dst):
        return self.run(['pull', str(src), str(dst)])

    @property
    def identity(self):
        return 'serial ' + self.serial

    def wait(self, timeout):
        deadline = time.monotonic() + timeout
        try:
            self.run(['wait-for-usb-device'], timeout=timeout)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise Error('Timed out waiting for USB adb')
            self.connect(timeout=min(5, remaining))
        except Error as exc:
            raise Error('USB adb wait failed. ' + CABLE_HINT + ' ' + str(exc)) from None

    def interactive_shell(self):
        self.run(['shell'], interactive=True)

    def framebuffer(self, stride, yoff, height):
        remote = '/tmp/slopctl-fb-' + uuid.uuid4().hex
        try:
            self.shell(f'dd if=/dev/fb0 of={q(remote)} bs={stride} skip={yoff} count={height}')
            with tempfile.TemporaryDirectory(prefix='slopctl-shot-') as td:
                local = Path(td) / 'fb.raw'
                self.pull(remote, local)
                return local.read_bytes()
        finally:
            self.shell(f'rm -f {q(remote)}', timeout=5)


class Ssh:
    name = 'ssh'

    def __init__(self, host='slop'):
        if not host or host.startswith('-'):
            raise Error('SSH host must be a nonempty host name or config alias')
        self.binary = shutil.which('ssh') or 'ssh'
        self.host = host

    @property
    def identity(self):
        return 'host ' + self.host

    def run(self, args, timeout=30, payload=None, interactive=False, connect_timeout=None):
        argv = [self.binary, '-o', 'BatchMode=yes']
        if connect_timeout is not None:
            argv += ['-o', f'ConnectTimeout={connect_timeout}']
        if interactive:
            argv += ['-tt']
        argv += [self.host] + list(args)
        try:
            result = subprocess.run(argv, timeout=min(timeout, 30),
                                    stdin=None if interactive else (payload if payload is not None else subprocess.DEVNULL),
                                    capture_output=not interactive)
        except FileNotFoundError:
            raise Error('ssh is missing. Put OpenSSH on PATH.') from None
        except subprocess.TimeoutExpired:
            raise Error(f'ssh command timed out after {min(timeout, 30):g} s') from None
        if result.returncode:
            detail = '' if interactive else (result.stderr or result.stdout).decode(errors='replace').strip()
            detail = ' '.join(detail.splitlines())
            raise Error(f'device command exited {result.returncode}' + (f': {detail}' if detail else ''))
        return b'' if interactive else result.stdout

    def connect(self, timeout=5):
        self.run(['true'], timeout=timeout, connect_timeout=max(1, math.ceil(timeout)))
        return self.host

    def wait(self, timeout):
        self.connect(timeout=timeout)

    def shell_bytes(self, command, timeout=30, payload=None):
        # OpenSSH joins command arguments into a remote shell command.
        return self.run(['sh', '-c', q(command)], timeout=timeout, payload=payload)

    def shell(self, command, timeout=30):
        return self.shell_bytes(command, timeout=timeout).decode(errors='replace')

    def push(self, src, dst):
        temp = str(PurePosixPath(dst).parent / ('.slopctl-' + uuid.uuid4().hex))
        command = (f'trap {q("rm -f " + q(temp))} EXIT HUP INT TERM; '
                   f'cat > {q(temp)} && mv -f {q(temp)} {q(dst)}')
        with Path(src).open('rb') as payload:
            self.shell_bytes(command, payload=payload)
        return ''

    def pull(self, src, dst):
        Path(dst).write_bytes(self.shell_bytes('cat ' + q(src)))
        return ''

    def interactive_shell(self):
        self.run([], interactive=True)

    def framebuffer(self, stride, yoff, height):
        return self.shell_bytes(f'dd if=/dev/fb0 bs={stride} skip={yoff} count={height}')


def select_transport(mode, host, wait_timeout=None):
    if mode in ('auto', 'ssh'):
        device = Ssh(host)
        try:
            if mode == 'ssh' and wait_timeout is not None:
                device.wait(wait_timeout)
            else:
                device.connect(timeout=3 if mode == 'auto' else 5)
            return device
        except Error:
            if mode == 'ssh':
                raise
    device = Adb()
    if wait_timeout is not None:
        device.wait(wait_timeout)
    else:
        device.connect()
    return device


def default_source():
    configured = os.environ.get('SLOPCTL_SRC')
    if configured:
        return configured
    candidate = Path(__file__).resolve().parents[2].parent / 'slop-device-build/dist-device'
    return str(candidate) if candidate.is_dir() else None


PID_FUNCTION = r'''
slot_pids() {
    for f in /proc/[0-9]*/cmdline; do
        [ -r "$f" ] || continue
        if tr '\000' '\n' < "$f" 2>/dev/null | grep -Fx /mnt/sdcard/System/slot >/dev/null; then
            p=${f#/proc/}; printf '%s\n' "${p%/cmdline}"
        fi
    done
}
'''


def slot_pids(device):
    return device.shell(PID_FUNCTION + 'slot_pids').split()


SAVE_ACK_FUNCTION = r'''
save_ack() {
    for pid in "$@"; do
        line=$(grep -h -F "slot: sigterm: pid $pid:" /mnt/sdcard/slot.log /mnt/sdcard/slot.log.1 2>/dev/null)
        [ -n "$line" ] && printf '%s\n' "$line" ||
            echo "slot: sigterm: pid $pid: no save acknowledgement; this slot build may predate the SIGTERM handler"
    done
}
'''


def save_acknowledgements(output, pids=()):
    lines = dict(re.findall(r'^slot: sigterm: pid (\d+): (.*)$', output, re.MULTILINE))
    for pid in dict.fromkeys([*pids, *lines]):
        outcome = lines.get(pid, 'no save acknowledgement; this slot build may predate the SIGTERM handler')
        if outcome == 'saved, exiting':
            print(f'slot pid {pid}: saved')
        else:
            print(f'slopctl: warning: slot pid {pid}: {outcome}', file=sys.stderr)


def lifecycle(device, action):
    if action == 'stop':
        device.shell(f'grep -F {q(HOLD)} {q(CARD + "/System/launch_frontend.sh")} >/dev/null || '
                  '{ echo "Deploy the updated launch_frontend.sh with hold support first"; exit 1; }; '
                  f': > {q(HOLD)}')
    elif action == 'start':
        device.shell(f'rm -f {q(HOLD)}')
    else:
        if device.shell(f'[ -e {q(HOLD)} ] && echo held; :').strip():
            raise Error('Frontend is held. Use start to clear the hold before restart.')
    old = []
    if action != 'start':
        old = slot_pids(device)
        if old:
            device.shell('; '.join(f'kill -TERM {q(p)} || [ ! -d /proc/{q(p)} ] || exit 1' for p in old))
            alive = ' || '.join(f'[ -d /proc/{q(p)} ]' for p in old)
            result = device.shell(SAVE_ACK_FUNCTION + 'n=0; while ' + alive +
                                  '; do [ "$n" -lt 10 ] || { echo term_timeout; exit 0; }; '
                                  'sleep 1; n=$((n+1)); done; save_ack ' + ' '.join(q(p) for p in old), timeout=12)
            if result.strip() != 'term_timeout':
                save_acknowledgements(result, old)
            else:
                if action == 'stop':
                    raise Error('slot did not exit after SIGTERM; hold remains set')
                print('slopctl: warning: slot did not exit after SIGTERM in 10 s; '
                      'sending SIGKILL, saves may be lost.', file=sys.stderr)
                device.shell('; '.join(f'kill -KILL {q(p)} || [ ! -d /proc/{q(p)} ] || exit 1' for p in old))
                device.shell('n=0; while ' + alive +
                             '; do [ "$n" -lt 5 ] || { echo "slot did not exit after SIGKILL"; exit 1; }; '
                             'sleep 1; n=$((n+1)); done', timeout=7)
        if action == 'stop':
            result = device.shell(PID_FUNCTION + SAVE_ACK_FUNCTION + '''
n=0
quiet=0
terminated=
while :; do
    pids=$(slot_pids)
    if [ -n "$pids" ]; then
        quiet=0
        for pid in $pids; do
            case " $terminated " in
                *" $pid "*) ;;
                *) kill -TERM "$pid" || [ ! -d "/proc/$pid" ] || exit 1
                   terminated="$terminated $pid" ;;
            esac
        done
    else
        quiet=$((quiet+1))
        if [ "$quiet" -ge 2 ]; then
            save_ack $terminated
            exit 0
        fi
    fi
    [ "$n" -lt 15 ] || { echo 'Frontend did not stay stopped within 15 s; hold remains set'; exit 1; }
    sleep 1
    n=$((n+1))
done
''', timeout=18)
            save_acknowledgements(result)
            print('Frontend stopped; hold set.')
            return
    result = device.shell(PID_FUNCTION + 'old=' + q(' ' + ' '.join(old) + ' ') + '''
n=0
while :; do
    p=
    for pid in $(slot_pids); do
        case "$old" in *" $pid "*) ;; *) p="$p $pid" ;; esac
    done
    [ -z "$p" ] || { echo "$p"; break; }
    [ "$n" -lt 10 ] || { echo 'No new slot pid after 10 s'; exit 1; }
    sleep 1; n=$((n+1))
done
''', timeout=12)
    print('slot pid: ' + result.strip())


def awake(device, state):
    if state == 'on':
        device.shell(': > ' + q(AWAKE))
    elif state == 'off':
        device.shell('rm -f ' + q(AWAKE))
    result = device.shell(f'if [ -e {q(AWAKE)} ]; then echo on; else echo off; fi').strip()
    print('Awake: ' + result)


