def logs(device, args):
    paths = {'slot': CARD + '/slot.log', 'prev': CARD + '/slot.log.1',
             'session': CARD + '/slot-session.log', 'frontend': '/tmp/generic.log'}
    boot = device.shell('for p in /mnt/sdcard/baseos-boot.log /tmp/baseos-boot.log /data/baseos-boot.log; '
                     'do [ ! -f "$p" ] || { echo "$p"; break; }; done; :').strip()
    paths['boot'] = boot or '/tmp/baseos-boot.log'
    pattern = re.compile(args.grep) if args.grep else None
    names = paths if args.kind == 'all' else [args.kind]
    for name in names:
        print(f'=== {name}: {paths[name]} ===')
        output = device.shell(f'if [ -f {q(paths[name])} ]; then tail -n {args.lines} {q(paths[name])}; '
                           'else echo "(missing)"; fi')
        for line in output.splitlines():
            if pattern is None or pattern.search(line):
                print(line)


def safe_relative(relative):
    p = PurePosixPath(relative)
    if p.is_absolute() or not p.parts or any(x in ('.', '..') for x in p.parts):
        raise Error(f'Unsafe deploy path: {relative}')
    if p.parts[0].lower() in PROTECTED:
        raise Error(f'Protected deploy directory: {p.parts[0]}')
    if p.parts[0] not in PAYLOAD or len(p.parts) < 2:
        raise Error(f'Not a frontend payload path: {relative}')
    if any('\n' in x or '\r' in x or '\t' in x for x in p.parts):
        raise Error(f'Unsupported newline or tab in deploy path: {relative!r}')
    return p


def is_example(relative):
    name = PurePosixPath(relative).name.lower()
    return name.endswith(('.example', '.sample')) or '.example.' in name or '.sample.' in name


def deploy_files(src, only):
    src = Path(src)
    if not src.is_dir() or src.is_symlink():
        raise Error(f'Deploy source must be a real directory: {src}')
    if src.name.lower() in PROTECTED:
        raise Error(f'Protected deploy directory: {src.name}')
    groups = {'system': {'System'}, 'shaders': {'Shaders'},
              'config-examples': {'Config'}, 'all': PAYLOAD}[only]
    files, skipped = [], 0
    for file in sorted(src.rglob('*')):
        rel = file.relative_to(src).as_posix()
        top = PurePosixPath(rel).parts[0]
        if file.is_symlink():
            raise Error(f'Symlinks are not supported in deploy sources: {rel}')
        if not file.is_file():
            continue
        if top not in groups:
            skipped += 1
            continue
        safe_relative(rel)
        if only == 'config-examples' and not is_example(rel):
            skipped += 1
            continue
        files.append((file, rel))
    return files, skipped


def device_hashes(device, files):
    # One shell call covers existence and all hashes, with no reliance on filename parsing.
    script = '''
if command -v sha256sum >/dev/null 2>&1; then h=sha256sum
elif command -v md5sum >/dev/null 2>&1; then h=md5sum
else echo 'No sha256sum or md5sum available'; exit 1; fi
printf 'algorithm=%s\\n' "$h"
'''
    for index, (_, rel) in enumerate(files):
        target = q(CARD + '/' + rel)
        script += (f'if [ -e {target} ]; then '
                   f'v=$($h {target}) || exit 1; v=${{v%% *}}; '
                   f"printf '{index}=%s\\n' \"$v\"; else echo '{index}=-'; fi\n")
    output = device.shell(script)
    rows = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
    algorithm = {'sha256sum': 'sha256', 'md5sum': 'md5'}.get(rows.get('algorithm'))
    if not algorithm or any(str(i) not in rows for i in range(len(files))):
        raise Error('Incomplete device hash inventory')
    return algorithm, rows


def atomic_command(temp, target, preserve=False):
    # Recheck Config at the final write boundary, including VFAT case aliases.
    if preserve:
        return (f'if [ -e {q(target)} ]; then rm -f {q(temp)} && echo skipped; '
                f'else mv -f {q(temp)} {q(target)} && echo pushed; fi')
    return f'mv -f {q(temp)} {q(target)} && echo pushed'


def deploy(device, args):
    if not args.src:
        raise Error('Deploy source not found. Supply --src or set SLOPCTL_SRC.')
    files, skipped = deploy_files(args.src, args.only)
    device.shell("grep ' /mnt/sdcard ' /proc/mounts >/dev/null || "
              "{ echo 'Frontend card is not mounted; refuse deploy'; exit 1; }")
    if not args.dry_run and not args.no_restart:
        if device.shell(f'[ -e {q(HOLD)} ] && echo held; :').strip():
            raise Error('Frontend is held. Deploy with --no-restart, then use start.')
    algorithm, remote = device_hashes(device, files)
    pushed = unchanged = 0
    for index, (file, rel) in enumerate(files):
        preserve = rel.startswith('Config/') and not is_example(rel)
        if preserve and remote[str(index)] != '-':
            skipped += 1
            print(f'skip existing config: {rel}')
            continue
        with file.open('rb') as stream:
            digest = hashlib.file_digest(stream, algorithm).hexdigest()
        if digest == remote[str(index)]:
            unchanged += 1
            continue
        if args.dry_run:
            pushed += 1
            print(f'would push: {rel}')
            continue
        target = CARD + '/' + rel
        temp = str(PurePosixPath(target).parent / ('.slopctl-' + uuid.uuid4().hex))
        device.shell(f'mkdir -p {q(PurePosixPath(target).parent)}')
        try:
            device.push(file, temp)
            hash_tool = 'sha256sum' if algorithm == 'sha256' else 'md5sum'
            verify = (f'v=$({hash_tool} {q(temp)}) || exit 1; v=${{v%% *}}; '
                      f'[ "$v" = {q(digest)} ] || {{ echo "Transfer hash mismatch"; exit 1; }}; ')
            result = device.shell(verify + atomic_command(temp, target, preserve)).strip()
            if result == 'skipped':
                skipped += 1
            elif result == 'pushed':
                pushed += 1
                print(f'pushed: {rel}')
            else:
                raise Error('Atomic deploy returned an unexpected result')
        finally:
            device.shell(f'rm -f {q(temp)}')
    print(f'{"Dry run: " if args.dry_run else ""}pushed={pushed} unchanged={unchanged} skipped={skipped}')
    if not args.dry_run:
        device.shell('sync')
        if not args.no_restart:
            lifecycle(device, 'restart')


def encode_png(raw, width, height, bpp, stride, rotate=0):
    if width <= 0 or height <= 0 or bpp not in (16, 32) or stride < width * (bpp // 8):
        raise Error('Unsupported framebuffer geometry')
    if len(raw) != stride * height:
        raise Error(f'Framebuffer length {len(raw)} does not match {stride * height}')
    pixels = []
    for y in range(height):
        row = []
        for x in range(width):
            offset = y * stride + x * (bpp // 8)
            if bpp == 32:
                b, g, r, _ = raw[offset:offset + 4]
            else:
                value = struct.unpack_from('<H', raw, offset)[0]
                r, g, b = ((value >> 11) * 255 // 31,
                           ((value >> 5) & 63) * 255 // 63, (value & 31) * 255 // 31)
            row.append(bytes((r, g, b)))
        pixels.append(row)
    for _ in range(rotate // 90):
        pixels = [list(row) for row in zip(*pixels[::-1])]
    height, width = len(pixels), len(pixels[0])
    def chunk(kind, data):
        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))
    scan = b''.join(b'\0' + b''.join(row) for row in pixels)
    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(scan)) + chunk(b'IEND', b''))


def shot(device, args):
    output = device.shell('for k in virtual_size bits_per_pixel stride pan modes; do '
                       'printf "%s=" "$k"; cat /sys/class/graphics/fb0/$k || exit 1; done')
    attrs = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
    vw, vh = map(int, attrs['virtual_size'].split(','))
    bpp, stride = int(attrs['bits_per_pixel']), int(attrs['stride'])
    xoff, yoff = map(int, attrs['pan'].split(','))
    mode = re.search(r'(\d+)x(\d+)', attrs['modes'])
    if not mode:
        raise Error('Cannot determine visible resolution from fb0/modes')
    width, height = map(int, mode.groups())
    if (bpp not in (16, 32) or width <= 0 or height <= 0 or yoff < 0
            or stride < width * (bpp // 8) or width + xoff > vw or height + yoff > vh or xoff != 0):
        raise Error('Unsupported framebuffer page layout')
    raw = device.framebuffer(stride, yoff, height)
    png = encode_png(raw, width, height, bpp, stride, args.rotate)
    out = Path(args.out) if args.out else Path('slopctl-shots') / (
        datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f') + '.png')
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(png)
    print(out)


def event_bytes(button, down=True):
    kind, code, value = BUTTONS[button.upper()]
    return struct.pack('<qqHHi', 0, 0, kind, code, value if down else 0) + struct.pack('<qqHHi', 0, 0, 0, 0, 0)


def capability_has(words, code):
    return bool(int(''.join(f'{int(word, 16):016x}' for word in words.split()) or '0', 16) & (1 << code))


def discover_event(listing, button):
    kind, code, _ = BUTTONS[button]
    matches = []
    for block in listing.strip().split('\n\n'):
        name = re.search(r'^N: Name="(.*)"$', block, re.M)
        handlers = re.search(r'^H: Handlers=(.*)$', block, re.M)
        cap = re.search(r'^B: ' + ('KEY' if kind == 1 else 'ABS') + r'=(.*)$', block, re.M)
        if not (name and handlers and cap and capability_has(cap.group(1), code)):
            continue
        node = re.search(r'\bevent\d+\b', handlers.group(1))
        if node:
            matches.append((node.group(), name.group(1)))
    if len(matches) != 1:
        raise Error(f'Expected one input device for {button}, found {len(matches)}')
    node, name = matches[0]
    return '/dev/input/' + node, name


def delay(ms):
    # Probe the actual runtime, since BaseOS packages Alpine busybox-static.
    return (f'if command -v usleep >/dev/null 2>&1; then usleep {ms * 1000}; '
            f'else sleep {ms / 1000:.3f} 2>/dev/null || sleep {math.ceil(ms / 1000)}; fi')


def parse_seq(sequence):
    actions = []
    for item in sequence.split(','):
        words = item.strip().upper().split()
        if not words or len(words) > 2:
            raise Error(f'Invalid sequence item: {item!r}')
        button = words[0]
        if button != 'WAIT' and button not in BUTTONS:
            raise Error(f'Unknown button: {button}')
        if button == 'WAIT' and len(words) != 2:
            raise Error('wait requires a duration in milliseconds')
        ms = int(words[1]) if len(words) == 2 else 100
        if not 0 <= ms <= 10000:
            raise Error('Input durations must be between 0 and 10000 ms')
        actions.append((button, ms))
    if sum(ms for _, ms in actions) > 20000 or len(actions) > 50:
        raise Error('Sequence exceeds 20 s or 50 actions')
    return actions


def inject(device, actions):
    listing = device.shell('cat /proc/bus/input/devices')
    nodes = {button: discover_event(listing, button) for button, _ in actions if button != 'WAIT'}
    remote_dir = '/tmp/slopctl-input-' + uuid.uuid4().hex
    device.shell(f'mkdir {q(remote_dir)}')
    try:
        with tempfile.TemporaryDirectory(prefix='slopctl-input-') as td:
            script = []
            for index, (button, ms) in enumerate(actions):
                if button == 'WAIT':
                    script.append(delay(ms) + ' || exit 1')
                    continue
                paths = []
                for down in (True, False):
                    name = f'{index}-{int(down)}'
                    local = Path(td) / name
                    local.write_bytes(event_bytes(button, down))
                    remote = remote_dir + '/' + name
                    device.push(local, remote)
                    paths.append(remote)
                raw_node, name = nodes[button]
                node = q(raw_node)
                sys_name = '/sys/class/input/' + PurePosixPath(raw_node).name + '/device/name'
                script.append(f'[ "$(cat {q(sys_name)})" = {q(name)} ] || '
                              '{ echo "Input device name changed"; exit 1; }')
                # A trap releases a held button on shell failure or termination.
                script.append(f'trap {q("cat " + q(paths[1]) + " > " + node)} EXIT HUP INT TERM')
                script.append(f'cat {q(paths[0])} > {node} || exit 1')
                script.append(delay(ms) + ' || exit 1')
                script.append(f'cat {q(paths[1])} > {node} || exit 1')
                script.append('trap - EXIT HUP INT TERM')
            device.shell('\n'.join(script), timeout=30)
    finally:
        device.shell(f'rm -rf {q(remote_dir)}')


def bounded_int(low, high):
    def parse(value):
        number = int(value)
        if not low <= number <= high:
            raise argparse.ArgumentTypeError(f'must be between {low} and {high}')
        return number
    return parse


def parser():
    p = argparse.ArgumentParser(description='Drive Slop over Wi-Fi SSH or USB adb. ' + CABLE_HINT)
    p.add_argument('--transport', choices=['auto', 'ssh', 'adb'],
                   default=os.environ.get('SLOPCTL_TRANSPORT', 'auto'))
    p.add_argument('--host', default=os.environ.get('SLOPCTL_HOST', 'slop'))
    p.add_argument('-v', '--verbose', action='store_true')
    sub = p.add_subparsers(dest='command', required=True)
    for name in ('status', 'buttons'):
        sub.add_parser(name)
    sub.add_parser('restart', help='Send SIGTERM, report save acknowledgements, and wait for respawn.')
    sub.add_parser('stop', help='Set the hold, send SIGTERM, and confirm two empty scans within 15 s.')
    sub.add_parser('start', help='Clear the hold and wait for slot.')
    awake_parser = sub.add_parser('awake', help='Keep the console powered on during an agent session')
    awake_parser.add_argument('state', choices=['on', 'off', 'status'])
    wait = sub.add_parser('wait', help='Wait for the selected transport, at most 30 s')
    wait.add_argument('--timeout', type=bounded_int(1, 30), default=20, metavar='S')
    log = sub.add_parser('logs')
    log.add_argument('kind', nargs='?', choices=['slot', 'prev', 'session', 'boot', 'frontend', 'all'], default='slot')
    log.add_argument('--lines', type=bounded_int(1, 100000), default=100, metavar='N')
    log.add_argument('--grep', metavar='RE')
    dep = sub.add_parser('deploy')
    dep.add_argument('--src', default=default_source())
    dep.add_argument('--only', choices=['system', 'shaders', 'config-examples', 'all'], default='all')
    dep.add_argument('--dry-run', action='store_true')
    dep.add_argument('--no-restart', action='store_true')
    capture = sub.add_parser('shot')
    capture.add_argument('out', nargs='?', metavar='OUT.png')
    capture.add_argument('--rotate', type=int, choices=[0, 90, 180, 270], default=0)
    press = sub.add_parser('press')
    press.add_argument('button', type=str.upper, choices=list(BUTTONS))
    press.add_argument('--hold', type=bounded_int(0, 10000), default=100, metavar='MS')
    sequence = sub.add_parser('seq')
    sequence.add_argument('sequence', help='Example: A 100, wait 500, DOWN, START')
    shell = sub.add_parser('shell')
    shell.add_argument('cmd', nargs=argparse.REMAINDER)
    for name in ('push', 'pull'):
        transfer = sub.add_parser(name)
        transfer.add_argument('src')
        transfer.add_argument('dst')
    return p


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        if args.command == 'buttons':
            for button, (kind, code, value) in BUTTONS.items():
                print(f'{button:8} {"EV_KEY" if kind == 1 else "EV_ABS"} code=0x{code:x} down={value} up=0')
            return 0
        if args.transport not in ('auto', 'ssh', 'adb'):
            raise Error('SLOPCTL_TRANSPORT must be auto, ssh, or adb')
        device = select_transport(args.transport, args.host,
                                  args.timeout if args.command == 'wait' else None)
        if args.verbose:
            print(f'slopctl: using {device.name} ({device.identity})', file=sys.stderr)
        if args.command == 'wait':
            print(f'Ready: {device.name}, {device.identity}')
            return 0
        if args.command == 'status':
            status(device)
        elif args.command == 'awake':
            awake(device, args.state)
        elif args.command == 'logs':
            logs(device, args)
        elif args.command in ('restart', 'stop', 'start'):
            lifecycle(device, args.command)
        elif args.command == 'deploy':
            deploy(device, args)
        elif args.command == 'shot':
            shot(device, args)
        elif args.command == 'press':
            inject(device, [(args.button, args.hold)])
        elif args.command == 'seq':
            inject(device, parse_seq(args.sequence))
        elif args.command == 'shell':
            if len(args.cmd) == 1:
                # One argument is a whole shell command, so pipes and redirects work.
                print(device.shell(args.cmd[0]), end='')
            elif args.cmd:
                print(device.shell(' '.join(q(arg) for arg in args.cmd)), end='')
            else:
                device.interactive_shell()
        elif args.command in ('push', 'pull'):
            print(getattr(device, args.command)(args.src, args.dst), end='')
        return 0
    except (Error, OSError, ValueError, KeyError, re.error) as exc:
        print(f'slopctl: {exc}', file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print('slopctl: interrupted', file=sys.stderr)
        return 130


if __name__ == '__main__':
    sys.exit(main())
